generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id           String @id @default(uuid())
  passwordHash String
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model PageContent {
  id         String   @id @default(uuid())
  pageKey    String
  sectionKey String
  title      String?
  body       String?
  imageUrl   String?
  updatedAt  DateTime @updatedAt

  @@unique([pageKey, sectionKey])
}

model Event {
  id             String   @id @default(uuid())
  title          String
  date           DateTime
  location       String?
  description    String?
  applicationUrl String?
  qrImageUrl     String?
  pamphletUrl    String?
  status         String   @default("UPCOMING") // UPCOMING, ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
